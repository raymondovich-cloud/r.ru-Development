/* Unified workspace trash */
.trash-page { display: grid; gap: 24px; }
.trash-category { display: grid; gap: 12px; }
.trash-category-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.trash-category-heading h2 { margin: 0; font-size: 18px; font-weight: 670; letter-spacing: -.03em; }
.trash-category-heading > span { display: grid; min-width: 26px; height: 26px; place-items: center; padding: 0 7px; border: 1px solid var(--color-surface-border); border-radius: 999px; color: var(--color-text-muted); font-size: 11px; }
.trash-item-list { display: grid; gap: 10px; }
.trash-item-card { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 16px; padding: 17px; border: 1px solid var(--color-surface-border); border-radius: 18px; background: var(--color-surface); box-shadow: var(--shadow-surface); }
.trash-item-copy { min-width: 0; }
.trash-item-copy h3 { margin: 6px 0 0; overflow-wrap: anywhere; font-size: 15px; font-weight: 650; }
.trash-item-copy p { margin: 5px 0 0; color: var(--color-text-muted); font-size: 12px; line-height: 1.5; }
.trash-item-copy time { display: block; margin-top: 8px; color: var(--color-text-muted); font-size: 11px; }
.trash-restore-button { flex: 0 0 auto; min-height: 40px; }
.trash-empty-note, .trash-retention-note { margin: 0; color: var(--color-text-muted); font-size: 12px; line-height: 1.6; }
.trash-retention-note { padding-top: 14px; border-top: 1px solid var(--color-surface-border); }
@media (max-width: 560px) { .trash-item-card { align-items: flex-start; flex-direction: column; gap: 13px; padding: 14px; } .trash-restore-button { width: 100%; } }
